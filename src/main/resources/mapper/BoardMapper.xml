<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.tester.board.mapper.BoardMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="boardId">
        INSERT INTO board_table (writer, category, title, content)
        VALUES (#{writer}, #{category}, #{title}, #{content})
    </insert>

    <update id="update">
        UPDATE board_table
        SET writer = #{writer}, category = #{category}, title = #{title}, content = #{content}
        WHERE board_id = #{boardId}
    </update>

    <sql id="searchCondition">
        <if test="keyword != null and keyword != ''">
            <choose>
                <when test="searchType == 'title'">
                    title LIKE CONCAT('%', #{keyword}, '%')
                </when>
                <when test="searchType == 'content'">
                    content LIKE CONCAT('%', #{keyword}, '%')
                </when>
                <when test="searchType == 'writer'">
                    writer LIKE CONCAT('%', #{keyword}, '%')
                </when>
                <otherwise>
                    (title LIKE CONCAT('%', #{keyword}, '%')
                    OR content LIKE CONCAT('%', #{keyword}, '%')
                    OR writer LIKE CONCAT('%', #{keyword}, '%'))
                </otherwise>
            </choose>
        </if>
    </sql>

    <select id="findByPage" resultType="com.example.tester.board.dto.BoardListDto">
        SELECT category, title, writer, created_at
        FROM board_table
        <where>
            <include refid="searchCondition"/>
        </where>
        ORDER BY created_at DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*)
        FROM board_table
        <where>
            <include refid="searchCondition"/>
        </where>
    </select>

    <select id="findselect" resultType="com.example.tester.board.dto.BoardUpdateDto">
        SELECT board_id,category, title, writer, content, created_at
        FROM board_table
        WHERE board_id = #{boardId}
    </select>

    <delete id="deleteBoard" parameterType="long">
        DELETE FROM board_table WHERE board_id = #{boardId}
    </delete>


</mapper>
